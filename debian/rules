#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/default.mk

# A package build may have no git checkout, take the version from the changelog.
export VERSION = $(DEB_VERSION)

# Not part of compat 13 by default. Runs first so the tmpfiles owner exists.
execute_before_dh_installtmpfiles:
	dh_installsysusers

%:
	dh $@
