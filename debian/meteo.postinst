#!/bin/sh
set -e

# Enable the web client on first install only, so an admin's choice survives upgrades.
if [ "$1" = configure ] && [ -z "$2" ] && command -v lighttpd-enable-mod >/dev/null; then
    lighttpd-enable-mod webmeteo || true
    deb-systemd-invoke try-reload-or-restart lighttpd.service || true
fi

#DEBHELPER#
