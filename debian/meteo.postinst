#!/bin/bash
# postinst script for meteoserver
#
# see: dh_installdeb(1)

set -e

RUNAS=meteo

case "$1" in
    configure)
        if ! getent passwd "$RUNAS" >/dev/null
        then
            adduser --system --home /usr/share/webmeteo --no-create-home --quiet "$RUNAS"
        fi
        # dialout required for serial device access
        adduser "$RUNAS" dialout
        # Create folder to record meteo data
        mkdir -p /var/meteodata
        chmod 755 /var/meteodata
        chown -R "$RUNAS" /var/meteodata
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
